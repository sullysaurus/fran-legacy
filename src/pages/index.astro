---
import '../styles/global.css';

const paths = [
  {
    number: '01',
    label: 'For investors',
    title: 'Build income without becoming a landlord.',
    body: 'Explore real-estate-backed opportunities designed around your timeline, risk profile, and desired level of involvement.',
    bullets: ['Private money lending', 'Passive partnership structures', 'Deal-by-deal guidance'],
  },
  {
    number: '02',
    label: 'For wholesalers',
    title: 'Bring us the right deal. We’ll bring clarity and speed.',
    body: 'We review contracted single-family, multifamily, and select commercial opportunities with a focus on workable creative terms.',
    bullets: ['Clear acquisition criteria', 'Creative-finance deal review', 'A relationship beyond one closing'],
  },
  {
    number: '03',
    label: 'For dealmakers',
    title: 'Bridge the gap between contract and close.',
    body: 'Transactional lending may help cover earnest money deposits or short-term funding needs for qualified real estate transactions.',
    bullets: ['EMD transactional lending', 'Short-term deal support', 'Straightforward next steps'],
  },
];

const principles = [
  ['Clarity first', 'We explain the structure, tradeoffs, and responsibilities before you make a move.'],
  ['Aligned strategy', 'The right approach should fit the deal and the people involved, not force either into a template.'],
  ['Long-view thinking', 'Every transaction should support the portfolio and legacy you actually want to build.'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Fran Legacy helps investors, wholesalers, and property owners navigate creative real estate finance in Raleigh, North Carolina." />
    <meta name="theme-color" content="#081a2b" />
    <meta property="og:title" content="Fran Legacy | Creative Real Estate Finance" />
    <meta property="og:description" content="Creative real estate finance and deal support for investors, wholesalers, and property owners in Raleigh, North Carolina." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://franlegacy.netlify.app/" />
    <meta property="og:image" content="https://franlegacy.netlify.app/brand/og-social-share.png" />
    <meta property="og:image:secure_url" content="https://franlegacy.netlify.app/brand/og-social-share.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Fran Legacy — Build the kind of wealth that outlives you." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Fran Legacy | Creative Real Estate Finance" />
    <meta name="twitter:description" content="Creative real estate finance and deal support for investors, wholesalers, and property owners in Raleigh, North Carolina." />
    <meta name="twitter:image" content="https://franlegacy.netlify.app/brand/og-social-share.png" />
    <meta name="twitter:image:alt" content="Fran Legacy — Build the kind of wealth that outlives you." />
    <link rel="icon" type="image/png" href="/brand/favicon-512.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Instrument+Sans:wdth,wght@75..100,400..700&family=Newsreader:opsz,wght@6..72,400..700&display=swap" rel="stylesheet" />
    <title>Fran Legacy | Creative Real Estate Finance</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header" data-header>
        <a class="brand" href="#top" aria-label="Fran Legacy home">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 42 42"><path d="M8 5h12v6h-6v7h8v6h-8v13H8V5Zm15 0h11v32H23V5Zm6 6v20" /></svg>
          </span>
          <span><strong>FRAN LEGACY</strong><small>Real estate · Raleigh, NC</small></span>
        </a>

        <nav class="desktop-nav" aria-label="Primary navigation">
          <a href="/about">About</a>
          <a href="/investments">Investments</a>
          <a href="/private-money-lenders">Funding</a>
          <a href="/blog">Blog</a>
          <a href="/contact">Contact</a>
        </nav>

        <a class="button button-small header-cta" href="/contact">Book a consultation <span>↗</span></a>
        <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" data-menu-toggle>
          <span></span><span></span>
        </button>
      </header>

      <div class="mobile-menu" data-mobile-menu>
        <a href="/about">About</a><a href="/investments">Investments</a><a href="/private-money-lenders">Funding</a><a href="/blog">Blog</a><a href="/contact">Contact</a>
      </div>

      <main id="top">
        <section class="hero">
          <div class="hero-media" role="img" aria-label="Aerial view of a residential neighborhood"></div>
          <div class="hero-grid" aria-hidden="true"></div>
          <div class="hero-content reveal">
            <p class="eyebrow"><span></span> Creative finance, grounded in real estate</p>
            <h1>Build the kind of wealth that <em>outlives you.</em></h1>
            <p class="hero-copy">Strategy and deal support for people ready to turn real estate opportunities into durable income, stronger portfolios, and a lasting legacy.</p>
            <div class="hero-actions">
              <a class="button button-light" href="/contact">Start a conversation <span>↗</span></a>
              <a class="text-link" href="#solutions">Explore how we help <span>↓</span></a>
            </div>
          </div>
          <div class="hero-note reveal reveal-delay">
            <span>Based in</span><strong>Raleigh, NC</strong>
          </div>
          <div class="hero-index">FL / 01</div>
        </section>

        <section class="manifesto" id="approach">
          <div class="section-kicker">Our point of view</div>
          <div class="manifesto-copy">
            <p>Real estate can create more than a return.</p>
            <h2>It can create <em>options.</em></h2>
          </div>
          <p class="manifesto-detail">Most people don’t need another one-size-fits-all playbook. They need a trusted partner who can see the whole deal, explain the paths forward, and help execute the one that fits.</p>
        </section>

        <section class="solutions" id="solutions">
          <div class="section-heading">
            <div>
              <p class="section-kicker light">Ways to work with us</p>
              <h2>One goal.<br /><em>Three paths.</em></h2>
            </div>
            <p>Whether you have capital, a contract, or a promising deal, we help you understand what’s possible and what comes next.</p>
          </div>

          <div class="path-tabs" role="tablist" aria-label="Client paths">
            {paths.map((path, index) => (
              <button class:list={["path-tab", { active: index === 0 }]} role="tab" aria-selected={index === 0 ? 'true' : 'false'} data-tab={index}>
                <span>{path.number}</span>{path.label}
              </button>
            ))}
          </div>

          <div class="path-panels">
            {paths.map((path, index) => (
              <article class:list={["path-panel", { active: index === 0 }]} data-panel={index}>
                <div class="path-visual">
                  <span class="orbit orbit-one"></span><span class="orbit orbit-two"></span>
                  <span class="path-number">{path.number}</span>
                </div>
                <div class="path-content">
                  <p class="mono">{path.label}</p>
                  <h3>{path.title}</h3>
                  <p>{path.body}</p>
                  <ul>{path.bullets.map((bullet) => <li><span>↗</span>{bullet}</li>)}</ul>
                  <a class="button button-outline" href="#contact">Discuss your opportunity <span>↗</span></a>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="principles">
          <div class="section-heading dark-text">
            <div><p class="section-kicker">Why Fran Legacy</p><h2>Good deals start with<br /><em>better questions.</em></h2></div>
            <p>We bring disciplined thinking and human conversation to a space that is too often crowded with hype.</p>
          </div>
          <div class="principle-grid">
            {principles.map(([title, description], index) => (
              <article>
                <span class="mono">0{index + 1}</span>
                <div class="principle-icon" aria-hidden="true">{index === 0 ? '◌' : index === 1 ? '◇' : '↗'}</div>
                <h3>{title}</h3>
                <p>{description}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="process" id="process">
          <div class="process-intro">
            <p class="section-kicker light">A simple way forward</p>
            <h2>From first call<br />to <em>clear action.</em></h2>
            <p>No jargon maze. No pressure. Just a focused process to understand your goals, assess the opportunity, and decide the next right move.</p>
          </div>
          <ol class="process-list">
            <li><span>01</span><div><h3>Discover</h3><p>A focused 30-minute conversation about your goals, experience, and current opportunity.</p></div></li>
            <li><span>02</span><div><h3>Design</h3><p>We evaluate the deal and outline a strategy you can execute yourself, with us, or through us.</p></div></li>
            <li><span>03</span><div><h3>Move</h3><p>If the fit is right, we agree on clear terms and move forward with confidence.</p></div></li>
          </ol>
        </section>

        <section class="contact" id="contact">
          <div class="contact-copy">
            <p class="section-kicker">Let’s talk</p>
            <h2>Your next move could be the one that <em>changes the trajectory.</em></h2>
            <p>Tell us what you’re working on. We’ll respond with the best next step, usually within one business day.</p>
            <div class="contact-details">
              <a href="tel:+18774501550"><span>Call</span><strong class="contact-value">877 450 1550</strong></a>
              <a href="mailto:tfrancisco@franlegacy.com"><span>Email</span><strong class="contact-value">tfrancisco@franlegacy.com</strong></a>
              <p><span>Visit</span><strong class="contact-value">4208 Six Forks Rd, Suite 1000<br />Raleigh, NC 27609</strong></p>
            </div>
          </div>

          <form class="contact-form" data-contact-form>
            <div class="field-row">
              <label>First name<input name="firstName" autocomplete="given-name" required /></label>
              <label>Last name<input name="lastName" autocomplete="family-name" required /></label>
            </div>
            <label>Email address<input type="email" name="email" autocomplete="email" required /></label>
            <label>I’m interested in
              <select name="interest" required>
                <option value="">Select one</option>
                <option>Investor opportunities</option>
                <option>Submitting a wholesale deal</option>
                <option>Transactional / EMD lending</option>
                <option>Creative finance consulting</option>
              </select>
            </label>
            <label>Tell us a little more<textarea name="message" rows="4" placeholder="What are you working on?"></textarea></label>
            <button class="button button-dark" type="submit">Request a consultation <span>↗</span></button>
            <p class="form-note" data-form-note>Submitting opens your email app with the details pre-filled.</p>
          </form>
        </section>
      </main>

      <footer>
        <a class="brand footer-brand" href="#top">
          <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 42 42"><path d="M8 5h12v6h-6v7h8v6h-8v13H8V5Zm15 0h11v32H23V5Zm6 6v20" /></svg></span>
          <span><strong>FRAN LEGACY</strong><small>Build beyond today.</small></span>
        </a>
        <div class="footer-links"><a href="/about">About</a><a href="/investments">Investments</a><a href="/private-money-lenders">Funding</a><a href="/blog">Blog</a><a href="/contact">Contact</a><a href="/brand">Brand kit</a></div>
        <p>© {new Date().getFullYear()} Fran Legacy. All rights reserved.</p>
        <p class="disclaimer">Real estate investments involve risk. Information on this site is educational and does not constitute financial, legal, or tax advice. Returns are not guaranteed.</p>
        <a class="footer-credit" href="https://raleighaiguy.com" target="_blank" rel="noreferrer">Built by Raleigh AI Guy <span>↗</span></a>
      </footer>
    </div>

    <script>
      const menuButton = document.querySelector('[data-menu-toggle]');
      const mobileMenu = document.querySelector('[data-mobile-menu]');
      menuButton?.addEventListener('click', () => {
        const open = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!open));
        mobileMenu?.classList.toggle('open', !open);
        document.body.classList.toggle('menu-open', !open);
      });
      mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        menuButton?.setAttribute('aria-expanded', 'false');
        mobileMenu.classList.remove('open');
        document.body.classList.remove('menu-open');
      }));

      const tabs = document.querySelectorAll('[data-tab]');
      const panels = document.querySelectorAll('[data-panel]');
      tabs.forEach((tab) => tab.addEventListener('click', () => {
        const index = tab.getAttribute('data-tab');
        tabs.forEach((item) => {
          const active = item === tab;
          item.classList.toggle('active', active);
          item.setAttribute('aria-selected', String(active));
        });
        panels.forEach((panel) => panel.classList.toggle('active', panel.getAttribute('data-panel') === index));
      }));

      const form = document.querySelector('[data-contact-form]');
      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        const data = new FormData(form);
        const name = `${data.get('firstName')} ${data.get('lastName')}`;
        const subject = encodeURIComponent(`Consultation request from ${name}`);
        const body = encodeURIComponent(`Name: ${name}\nEmail: ${data.get('email')}\nInterest: ${data.get('interest')}\n\n${data.get('message') || ''}`);
        window.location.href = `mailto:tfrancisco@franlegacy.com?subject=${subject}&body=${body}`;
      });

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => entry.isIntersecting && entry.target.classList.add('in-view'));
      }, { threshold: 0.15 });
      document.querySelectorAll('.section-heading, .principle-grid article, .process-list li, .contact > *').forEach((element) => observer.observe(element));
    </script>
  </body>
</html>
